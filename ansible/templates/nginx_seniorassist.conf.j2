# Configuracion Nginx Reverse Proxy para SeniorAssist
# Maneja terminacion SSL, compresion GZIP y proteccion contra DoS

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;

server {
    listen 80;
    server_name {{ inventory_hostname }};

    # Redireccion forzosa a HTTPS en produccion
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ inventory_hostname }};

    # Certificados SSL gestionados por Let's Encrypt / Certbot
    ssl_certificate /etc/letsencrypt/live/{{ inventory_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ inventory_hostname }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Cabeceras de Seguridad HTTP (OWASP)
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Compresion de respuestas JSON para optimizar datos en moviles
    gzip on;
    gzip_types application/json text/plain;
    gzip_min_length 256;

    location / {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout adaptado para respuestas de IA de voz
        proxy_read_timeout 15s;
        proxy_connect_timeout 5s;
    }
}
