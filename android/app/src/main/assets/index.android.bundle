value:(p=(0,n.default)(function*(t){return(yield this.getAllLessons()).find(n=>n.id===t)||null}),function(t){return p.apply(this,arguments)})},{key:"getLessonSteps",value:function(t){switch(t){case'lesson-wa':return[{stepIndex:0,title:'Abrir conversaci\xf3n familiar',instruction:'Toca sobre el contacto de tu hija Mar\xeda para abrir el chat.',hint:'Busca la foto de Mar\xeda G\xf3mez en la lista y pulsa sobre su nombre.',targetAction:'SELECT_CONTACT',completedExplanation:'\xa1Muy bien! Acabas de abrir la conversaci\xf3n con Mar\xeda.'},{stepIndex:1,title:'Tocar el campo de texto',instruction:'Toca la barra blanca abajo para escribir tu mensaje.',hint:'Abajo hay un espacio rectangular que dice "Escribe un mensaje aqu\xed". P\xfalsalo.',targetAction:'TAP_INPUT',completedExplanation:'\xa1Excelente! El teclado simulado est\xe1 listo para escribir.'},{stepIndex:2,title:'Enviar el mensaje',instruction:'Toca el bot\xf3n verde con forma de flecha para enviar el mensaje.',hint:'El bot\xf3n verde con una flecha blanca est\xe1 a la derecha del texto.',targetAction:'TAP_SEND',completedExplanation:'\xa1Fant\xe1stico! Tu mensaje "Hola hija, ya llegu\xe9" fue enviado.'},{stepIndex:3,title:'Grabar nota de voz',instruction:'Mant\xe9n presionado el bot\xf3n verde del micr\xf3fono para hablar.',hint:'Abajo a la derecha ver\xe1s un c\xedrculo verde con un micr\xf3fono blanco. Mantenlo presionado.',targetAction:'RECORD_AUDIO',completedExplanation:'\xa1Perfecto! Has grabado y enviado tu nota de voz con \xe9xito.'},{stepIndex:4,title:'Iniciar videollamada',instruction:'Toca el icono de la c\xe1mara arriba para ver a tu ser querido.',hint:'En la barra superior, al lado del nombre de Mar\xeda, hay un icono con forma de c\xe1mara de video.',targetAction:'START_VIDEO_CALL',completedExplanation:'\xa1Fabuloso! Ya sabes c\xf3mo ver y escuchar a tu familia en directo.'}];case'lesson-cam':return[{stepIndex:0,title:'Enfocar el objetivo',instruction:'Toca en la pantalla sobre lo que quieres enfocar para asegurarte de que se vea n\xedtido.',hint:'Toca en el centro del visor para que aparezca el recuadro amarillo de enfoque.',targetAction:'FOCUS_VIEW',completedExplanation:'\xa1Muy bien! La imagen est\xe1 enfocada y n\xedtida.'},{stepIndex:1,title:'Tomar la fotograf\xeda',instruction:'Pulsa el bot\xf3n circular blanco grande abajo para disparar.',hint:'Es el bot\xf3n redondo m\xe1s grande en la parte inferior central de la pantalla.',targetAction:'TAKE_PHOTO',completedExplanation:'\xa1Click! Acabas de capturar un hermoso recuerdo.'},{stepIndex:2,title:'Cambiar a c\xe1mara frontal (Selfie)',instruction:'Toca el bot\xf3n con dos flechas giratorias para verte a ti mismo.',hint:'Est\xe1 a la derecha del bot\xf3n blanco de disparar.',targetAction:'FLIP_CAMERA',completedExplanation:'\xa1Genial! Ahora la c\xe1mara te enfoca a ti para tomarte una selfie.'},{stepIndex:3,title:'Revisar la fotograf\xeda',instruction:'Pulsa en la miniatura redonda abajo a la izquierda para verla en grande.',hint:'En la esquina inferior izquierda ver\xe1s la foto que acabas de tomar.',targetAction:'PREVIEW_PHOTO',completedExplanation:'\xa1Qu\xe9 bien qued\xf3! Puedes ver todos los detalles en grande.'},{stepIndex:4,title:'Eliminar foto de prueba',instruction:'Toca el bot\xf3n rojo de papelera para aprender a borrar fotos que no te gusten.',hint:'Busca el icono de papelera roja para descartar la foto con tranquilidad.',targetAction:'DELETE_PHOTO',completedExplanation:'\xa1Completado! No temas equivocarte, siempre puedes borrar lo que no quieras.'}];case'lesson-gal':return[{stepIndex:0,title:'Elegir una foto del \xe1lbum',instruction:'Toca sobre la fotograf\xeda del cumplea\xf1os familiar para verla completa.',hint:'En la cuadr\xedcula de fotos, pulsa la primera imagen grande de la reuni\xf3n.',targetAction:'SELECT_PHOTO',completedExplanation:'\xa1Excelente! La foto ahora se muestra en pantalla completa.'},{stepIndex:1,title:'Ampliar con zoom amigable',instruction:'Toca el bot\xf3n "Acercar" para ver las caras m\xe1s de cerca.',hint:'Pulsa el bot\xf3n con una lupa y el signo m\xe1s (+) para acercar los rostros.',targetAction:'ZOOM_PHOTO',completedExplanation:'\xa1Qu\xe9 n\xedtido! As\xed puedes apreciar los rostros sin forzar la vista.'},{stepIndex:2,title:'Compartir con un ser querido',instruction:'Toca el bot\xf3n "Compartir" para enviar esta foto a tu hija Mar\xeda.',hint:'Busca el bot\xf3n azul que dice "Compartir con Mar\xeda".',targetAction:'SHARE_PHOTO',completedExplanation:'\xa1Maravilloso! Mar\xeda acaba de recibir tu foto con una sonrisa.'}];case'lesson-sec':return[{stepIndex:0,title:'Mensaje falso del banco',instruction:'Te llega un mensaje: "Banco: Su cuenta est\xe1 bloqueada. Ingrese a este link urgente". \xbfQu\xe9 debes hacer?',hint:'Los bancos jam\xe1s te pedir\xe1n claves ni te enviar\xe1n enlaces de urgencia por mensaje.',targetAction:'REJECT_SCAM_SMS',completedExplanation:'\xa1Muy bien! Nunca abras enlaces desconocidos. Tu banco nunca pide claves por mensaje.'},{stepIndex:1,title:'Llamada de familiar en apuros',instruction:'Llaman diciendo: "\xa1T\xedo, tuve un accidente y necesito plata ya!". \xbfQu\xe9 decisi\xf3n tomas?',hint:'Mant\xe9n la calma. Antes de enviar dinero, cuelga y llama al n\xfamero guardado de ese familiar.',targetAction:'VERIFY_FAMILY_CALL',completedExplanation:'\xa1Excelente decisi\xf3n! Siempre cuelga y llama t\xfa mismo a tu familiar para confirmar.'},{stepIndex:2,title:'Premio falso de loter\xeda',instruction:'Mensaje: "\xa1Gan\xf3 una camioneta! Consigne $50.000 para el env\xedo". \xbfC\xf3mo respondes?',hint:'Nadie te regala premios sin participar, y jam\xe1s debes pagar dinero para reclamar nada.',targetAction:'REJECT_PRIZE_SCAM',completedExplanation:'\xa1Fant\xe1stico! Si te piden dinero para entregarte un premio, es 100% una estafa.'}];case'lesson-call':return[{stepIndex:0,title:'Identificar qui\xe9n te llama',instruction:'Tu tel\xe9fono est\xe1 timbrando. Lee el nombre y n\xfamero en pantalla antes de responder.',hint:'En la pantalla ver\xe1s el nombre "Doctor Mart\xednez (Salud)".',targetAction:'IDENTIFY_CALLER',completedExplanation:'\xa1Correcto! Siempre verifica qui\xe9n llama para mayor tranquilidad.'},{stepIndex:1,title:'Contestar la llamada',instruction:'Pulsa el bot\xf3n circular verde "CONTESTAR" para hablar.',hint:'Toca el bot\xf3n verde con el icono del auricular para iniciar la conversaci\xf3n.',targetAction:'ANSWER_CALL',completedExplanation:'\xa1Excelente! Ya est\xe1s comunicado con el doctor.'},{stepIndex:2,title:'Activar el altavoz',instruction:'Toca el bot\xf3n de "ALTAVOZ" para escuchar con volumen alto sin sostener el tel\xe9fono.',hint:'Busca el icono de parlante/altavoz en la pantalla de la llamada.',targetAction:'TOGGLE_SPEAKER',completedExplanation:'\xa1Perfecto! Con el altavoz puedes escuchar fuerte y claro.'},{stepIndex:3,title:'Colgar la llamada',instruction:'Toca el bot\xf3n circular rojo de "COLGAR" al terminar la conversaci\xf3n.',hint:'Es el bot\xf3n redondo rojo en la parte inferior.',targetAction:'END_CALL',completedExplanation:'\xa1Muy bien hecho! Has dominado c\xf3mo contestar, poner altavoz y colgar con seguridad.'}];case'lesson-audio':return[{stepIndex:0,title:'Reproducir nota de voz',instruction:'Te ha llegado un mensaje de voz de Mar\xeda. Toca el bot\xf3n verde de reproducir (\u25b6).',hint:'Pulsa el c\xedrculo verde con el tri\xe1ngulo blanco dentro del mensaje.',targetAction:'PLAY_VOICE_NOTE',completedExplanation:'\xa1Muy bien! El audio se est\xe1 reproduciendo.'},{stepIndex:1,title:'Pausar el audio',instruction:'Toca el bot\xf3n de pausa (\u23f8) para detener el mensaje si necesitas atender algo.',hint:'Pulsa las dos barras verticales que aparecieron en lugar del tri\xe1ngulo.',targetAction:'PAUSE_VOICE_NOTE',completedExplanation:'\xa1Excelente! Puedes pausar y reanudar el audio cuando desees.'},{stepIndex:2,title:'Ajustar velocidad del audio',instruction:'Toca el bot\xf3n "1.5x" para escuchar un audio largo m\xe1s r\xe1pidamente.',hint:'Toca sobre la etiqueta peque\xf1a que dice "1x" o "1.5x".',targetAction:'SPEED_VOICE_NOTE',completedExplanation:'\xa1Fabuloso! Ahora dominas el control de notas de voz en WhatsApp.'}];default:return[]}}},{key:"getRecentEvents",value:(u=(0,n.default)(function*(t){return(yield(0,s.getDatabase)()).getAllAsync('SELECT * FROM learning_events WHERE lesson_id = ? ORDER BY id DESC LIMIT 20',[t])}),function(t){return u.apply(this,arguments)})},{key:"seedInitialLessons",value:(c=(0,n.default)(function*(){var t=yield(0,s.getDatabase)();for(var n of[{id:'lesson-wa',module:'whatsapp',title:'Aprender WhatsApp',description:'Aprende a abrir una conversaci\xf3n, escribir y enviar notas de voz sin temor a equivocarte.',totalSteps:5,orderIndex:1},{id:'lesson-cam',module:'camera',title:'C\xf3mo Usar la C\xe1mara',description:'Aprende a apuntar, enfocar, tomar fotos, cambiar a selfie y revisarlas con calma.',totalSteps:5,orderIndex:2},{id:'lesson-gal',module:'gallery',title:'Tu Galer\xeda de Fotos',description:'Aprende a buscar recuerdos, verlos en pantalla grande y compartirlos con tu familia.',totalSteps:3,orderIndex:3},{id:'lesson-sec',module:'security',title:'Seguridad y Evitar Estafas',description:'Aprende a detectar mensajes falsos, llamadas sospechosas y a proteger tu tranquilidad.',totalSteps:3,orderIndex:4},{id:'lesson-call',module:'calls',title:'Contestar Llamadas y Altavoz',description:'Aprende a identificar qui\xe9n llama, contestar, activar el altavoz para escuchar fuerte y colgar.',totalSteps:4,orderIndex:5},{id:'lesson-audio',module:'audio',title:'Escuchar Audios en WhatsApp',description:'Aprende a reproducir notas de voz familiares, pausarlas y ajustar la velocidad.',totalSteps:3,orderIndex:6}])yield t.runAsync("INSERT OR REPLACE INTO lessons (id, module, title, description, total_steps, order_index)\n         VALUES (?, ?, ?, ?, ?, ?)",[n.id,n.module,n.title,n.description,n.totalSteps,n.orderIndex])}),function(){return c.apply(this,arguments)})}],[{key:"getInstance",value:function(){return t.instance||(t.instance=new t),t.instance}}]);var c,u,p,E,f,v})();e.learningRepository=c.getInstance()},938,[1,40,10,11,732]);
